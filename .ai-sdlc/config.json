{
  "$comment": "Single source of truth for the Story-to-Code guardrails. Read by .ai-sdlc/hooks/*.mjs and .ai-sdlc/guardrails/*.mjs. JSON (not YAML) so hooks run with zero dependencies.",
  "scopeFile": ".ai-sdlc/state/scope.json",
  "allowedWriteRoots": [
    "client/",
    "server/",
    "scripts/",
    "server.ts",
    "README.md"
  ],
  "protectedPaths": [
    ".ai-sdlc/",
    ".github/",
    ".claude/",
    ".cursor/",
    ".husky/",
    "AGENTS.md",
    "CLAUDE.md",
    ".cursorignore",
    ".gitignore",
    ".vscode/",
    ".mcp.json"
  ],
  "sensitiveFileGlobs": [
    ".env",
    ".env.*",
    "*.pem",
    "*.key",
    "id_rsa*",
    "scripts/data/*"
  ],
  "allowedSensitiveFiles": [
    ".env.example"
  ],
  "blockedExtensions": [
    ".pem",
    ".key",
    ".p12",
    ".pfx"
  ],
  "secretPatterns": [
    {
      "name": "private-key",
      "pattern": "-----BEGIN (?:RSA |EC |OPENSSH |DSA )?PRIVATE KEY-----"
    },
    {
      "name": "aws-access-key",
      "pattern": "AKIA[0-9A-Z]{16}"
    },
    {
      "name": "github-token",
      "pattern": "gh[pousr]_[A-Za-z0-9]{36,}"
    },
    {
      "name": "mongodb-uri-with-credentials",
      "pattern": "mongodb(?:\\+srv)?://[^\\s:@/]+:[^\\s@/]+@"
    },
    {
      "name": "jwt",
      "pattern": "eyJ[A-Za-z0-9_-]{10,}\\.eyJ[A-Za-z0-9_-]{10,}\\.[A-Za-z0-9_-]{10,}"
    },
    {
      "name": "hardcoded-secret-assignment",
      "pattern": "(?:secret|password|passwd|api[_-]?key|token)\\s*[:=]\\s*['\"][^'\"\\s]{12,}['\"]"
    }
  ],
  "piiPatterns": [
    {
      "name": "email",
      "pattern": "[A-Za-z0-9._%+-]+@[A-Za-z0-9.-]+\\.[A-Za-z]{2,}",
      "replacement": "[EMAIL]"
    },
    {
      "name": "phone",
      "pattern": "(?<!\\d)(?:\\+?\\d{1,3}[\\s-]?)?(?:\\d[\\s-]?){10}(?!\\d)",
      "replacement": "[PHONE]"
    },
    {
      "name": "ipv4",
      "pattern": "\\b(?:10|127|192\\.168|172\\.(?:1[6-9]|2\\d|3[01]))(?:\\.\\d{1,3}){2,3}\\b",
      "replacement": "[INTERNAL_IP]"
    },
    {
      "name": "mongodb-uri",
      "pattern": "mongodb(?:\\+srv)?://\\S+",
      "replacement": "[DB_URI]"
    }
  ],
  "selfHealing": {
    "maxAttempts": 3,
    "testTimeoutSeconds": 300
  }
}