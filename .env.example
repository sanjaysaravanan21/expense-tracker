# Server
PORT=4500
# Leave DB_URL unset (or unreachable) to serve in-memory mock data; log in as 9999999999 with OTP 123456
DB_URL=mongodb://localhost:27017/expense-tracker
# auto (default) | always | never (always "never" in production)
MOCK_DATA=auto
JWT_SECRET=change-me
JWT_EXPIRES_IN=7d
CORS_ORIGIN=http://localhost:5173
MAIL_USER=
MAIL_KEY=
# "disabled" is only accepted with NODE_ENV=test (used by Playwright E2E)
MAIL_TRANSPORT=gmail

# Client (Vite)
VITE_API_URL=http://localhost:4500
