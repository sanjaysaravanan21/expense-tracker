{
  "name": "expense-tracker",
  "version": "1.0.0",
  "private": true,
  "type": "module",
  "description": "Expense tracker: Express/Mongoose API (server/) and React UI (client/)",
  "engines": {
    "node": ">=20"
  },
  "scripts": {
    "test:ai": "node --test .ai-sdlc/hooks/guard.test.mjs .ai-sdlc/guardrails/guardrails.test.mjs",
    "ai:scope": "node .ai-sdlc/guardrails/set-scope.mjs",
    "ai:sanitize": "node .ai-sdlc/guardrails/sanitize-input.mjs",
    "ai:validate": "node .ai-sdlc/guardrails/pre-commit-validator.mjs",
    "prepare": "husky",
    "dev:server": "tsx watch --tsconfig server/tsconfig.json server.ts",
    "dev:client": "vite --config client/vite.config.ts --host",
    "build:server": "esbuild server.ts --bundle --platform=node --format=esm --packages=external --tsconfig=server/tsconfig.json --outfile=dist/server.js",
    "build:client": "tsc -p client/tsconfig.json && vite build --config client/vite.config.ts",
    "build": "npm run build:server && npm run build:client",
    "start": "node dist/server.js",
    "check-types": "tsc -p server/tsconfig.json && tsc -p client/tsconfig.json",
    "lint": "eslint . && eslint client",
    "test": "vitest run",
    "test:client": "vitest run --config client/vite.config.ts",
    "test:e2e": "playwright test --config client/playwright.config.ts"
  },
  "lint-staged": {
    "*.{ts,tsx,js,mjs}": "eslint --max-warnings=0 --no-warn-ignored"
  },
  "devDependencies": {
    "@eslint/js": "^10.0.1",
    "@playwright/test": "^1.65.0",
    "@testing-library/dom": "^10.4.2",
    "@testing-library/jest-dom": "^7.0.1",
    "@testing-library/react": "^16.3.3",
    "@testing-library/user-event": "^14.6.8",
    "@types/cors": "^2.8.19",
    "@types/express": "^5.0.6",
    "@types/jsonwebtoken": "^9.0.10",
    "@types/node": "^26.6.6",
    "@types/nodemailer": "^8.0.2",
    "@types/react": "^18.3.31",
    "@types/react-dom": "^18.3.7",
    "@types/supertest": "^7.2.1",
    "@vitejs/plugin-react": "^6.2.1",
    "autoprefixer": "^10.6.2",
    "esbuild": "^0.28.2",
    "eslint": "^10.14.0",
    "eslint-plugin-react-hooks": "^7.1.1",
    "eslint-plugin-react-refresh": "^0.5.7",
    "globals": "^17.14.0",
    "husky": "^9.1.7",
    "jsdom": "^29.1.1",
    "lint-staged": "^15.2.10",
    "msw": "^2.15.0",
    "postcss": "^8.5.32",
    "prettier": "^3.9.10",
    "supertest": "^7.3.1",
    "tailwindcss": "^3.4.19",
    "tsx": "^4.23.15",
    "typescript": "^6.0.3",
    "typescript-eslint": "^8.72.1",
    "vite": "^8.3.5",
    "vitest": "^4.1.12"
  },
  "dependencies": {
    "axios": "^1.21.0",
    "cors": "^2.8.6",
    "dotenv": "^18.0.9",
    "express": "^5.3.0",
    "express-rate-limit": "^8.7.3",
    "helmet": "^8.3.0",
    "jsonwebtoken": "^9.0.3",
    "moment": "^2.31.0",
    "mongoose": "^9.11.4",
    "nodemailer": "^10.3.1",
    "react": "^18.3.1",
    "react-dom": "^18.3.1",
    "react-router-dom": "^6.30.6",
    "recharts": "^2.15.4",
    "zod": "^4.6.7"
  }
}